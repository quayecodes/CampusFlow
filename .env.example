# ──────────────────────────────────────────────
# CampusFlow Environment Variables
# ──────────────────────────────────────────────
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local — it is gitignored.

# ── Database ──────────────────────────────────
# PostgreSQL connection string (Neon, Supabase, or local)
DATABASE_URL="postgresql://user:password@localhost:5432/campusflow?schema=public"

# ── NextAuth.js ───────────────────────────────
# Generate a random secret: openssl rand -base64 32
NEXTAUTH_SECRET="your secret key here"
# The canonical URL of your app (no trailing slash)
NEXTAUTH_URL="http://localhost:3000"
